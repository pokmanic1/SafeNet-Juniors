{ 
  "name": "safenet-juniors",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:css": "sass src/styles/app.scss public/assets/css/_pre.css && npx tailwindcss -i public/assets/css/_pre.css -o public/assets/css/app.css --config tailwind.config.js && rm public/assets/css/_pre.css",
    "watch:sass": "sass --watch src/styles/app.scss:public/assets/css/_pre.css",
    "watch:tailwind": "npx tailwindcss -i public/assets/css/_pre.css -o public/assets/css/app.css --config tailwind.config.js --watch",
    "watch:css": "concurrently \"npm:watch:sass\" \"npm:watch:tailwind\""
  },
  "keywords": [],
  "concurrently": "^9.2.1",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
  "@tailwindcss/cli": "^4.1.18",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sass": "^1.97.3",
    "tailwindcss": "^3.4.6"
  }
}
